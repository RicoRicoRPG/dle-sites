{
  "name": "dle-sites",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "refresh:speedrun": "node scripts/speedrundle-refresh.mjs",
    "poll": "node scripts/peakdle-poll.mjs",
    "close": "node scripts/peakdle-close.mjs",
    "puzzles": "node scripts/puzzles.mjs",
    "build": "node scripts/build.mjs",
    "test": "node test/check.mjs",
